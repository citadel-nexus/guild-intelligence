  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.16.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
